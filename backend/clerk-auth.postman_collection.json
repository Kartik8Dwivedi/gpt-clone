{
  "info": {
    "name": "Clerk Auth APIs",
    "_postman_id": "clerk-auth-collection-001",
    "description": "Collection for testing Clerk-based Auth APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sync User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/sync",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sync"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"user_12345\",\n  \"emailAddresses\": [{ \"emailAddress\": \"test@example.com\" }],\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"imageUrl\": \"https://example.com/avatar.png\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clerkToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      },
      "response": []
    }
  ]
}
